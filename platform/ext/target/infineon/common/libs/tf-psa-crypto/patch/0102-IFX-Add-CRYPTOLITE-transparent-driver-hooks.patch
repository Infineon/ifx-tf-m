 core/psa_crypto_driver_wrappers_no_static.c     |  25 ++
 include/psa/crypto_driver_contexts_composites.h |  12 +
 include/psa/crypto_driver_contexts_primitives.h |  16 ++
 4 files changed, 382 insertions(+)

diff --git a/core/psa_crypto_driver_wrappers.h b/core/psa_crypto_driver_wrappers.h
index 6f2ab30..8155482 100644
--- a/core/psa_crypto_driver_wrappers.h
+++ b/core/psa_crypto_driver_wrappers.h
@@ -93,6 +93,16 @@
