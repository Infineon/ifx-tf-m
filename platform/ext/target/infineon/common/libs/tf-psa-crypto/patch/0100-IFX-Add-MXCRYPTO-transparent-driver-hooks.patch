 core/psa_crypto_driver_wrappers_no_static.c   |  25 +-
 .../psa/crypto_driver_contexts_composites.h   |  12 +
 .../psa/crypto_driver_contexts_primitives.h   |  16 +
 4 files changed, 419 insertions(+), 5 deletions(-)

