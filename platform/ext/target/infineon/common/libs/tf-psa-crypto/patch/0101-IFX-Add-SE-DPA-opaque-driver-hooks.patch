From 73530f712a1474aa2fa260959b2230f7943674e9 Mon Sep 17 00:00:00 2001
From: "Kozemchuk Ivan (CSS ICW SW SCV BFS SFW / EE)"
 <Ivan.Kozemchuk-EE@infineon.com>
Date: Fri, 15 May 2026 12:17:23 +0300
Subject: [PATCH] IFX: Add SE-DPA opaque driver hooks.

---
 core/psa_crypto.c                             | 405 +++++++++--
 core/psa_crypto_driver_wrappers.h             | 666 ++++++++++++++++++
 core/psa_crypto_driver_wrappers_no_static.c   |  69 +-
 .../psa_crypto_driver_wrappers_no_static.h    |  10 +
 .../psa/crypto_driver_contexts_composites.h   |  12 +
 .../crypto_driver_contexts_key_derivation.h   |   3 +
 .../psa/crypto_driver_contexts_primitives.h   |  36 +
 7 files changed, 1136 insertions(+), 65 deletions(-)

diff --git a/core/psa_crypto.c b/core/psa_crypto.c
index 273ae81..4e7ca9f 100644
--- a/core/psa_crypto.c
+++ b/core/psa_crypto.c
@@ -1118,13 +1118,16 @@ static psa_status_t psa_get_and_lock_transparent_key_slot_with_policy(
         return status;
     }
 
-    if (psa_key_lifetime_is_external((*p_slot)->attr.lifetime)
+    if (psa_key_lifetime_is_external((*p_slot)->attr.lifetime)
 #if defined(PSA_CRYPTO_DRIVER_TFM_BUILTIN_KEY_LOADER)
         && (PSA_KEY_LIFETIME_GET_LOCATION((*p_slot)->attr.lifetime) != TFM_BUILTIN_KEY_LOADER_KEY_LOCATION)
 #endif /* PSA_CRYPTO_DRIVER_TFM_BUILTIN_KEY_LOADER */
 #if defined(CC3XX_CRYPTO_OPAQUE_KEYS)
         && (PSA_KEY_LIFETIME_GET_LOCATION((*p_slot)->attr.lifetime) != CC3XX_OPAQUE_KEY_LOCATION)
 #endif /* CC3XX_CRYPTO_OPAQUE_KEYS */
+    #if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+        && (PSA_KEY_LIFETIME_GET_LOCATION((*p_slot)->attr.lifetime) != PSA_KEY_LOCATION_IFX_SE)
+    #endif /* defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT) */
         ) {
         psa_unregister_read_under_mutex(*p_slot);
         *p_slot = NULL;
@@ -1305,6 +1308,22 @@ psa_status_t psa_destroy_key(mbedtls_svc_key_id_t key)
     }
 #endif /* defined(MBEDTLS_PSA_CRYPTO_STORAGE_C) */
 
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+        if (PSA_KEY_LIFETIME_GET_LOCATION(slot->attr.lifetime) ==
+            PSA_KEY_LOCATION_IFX_SE) {
+            ifx_se_key_id_fih_t se_key = IFX_SE_KEY_ID_FIH_INIT;
+            (void) memcpy(&se_key, slot->key.data, sizeof(se_key));
+
+            status = ifx_se_get_psa_status(
+                        ifx_se_destroy_key(se_key, IFX_SE_NULL_CTX));
+
+            overall_status = status;
+            goto exit;
+        }
+    }
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
+
 exit:
     /* Unregister from reading the slot. If we are the last active reader
      * then this will wipe the slot. */
@@ -1342,6 +1361,32 @@ psa_status_t psa_get_key_attributes(mbedtls_svc_key_id_t key,
 
     *attributes = slot->attr;
 
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+        if (PSA_KEY_LIFETIME_GET_LOCATION(slot->attr.lifetime) ==
+            PSA_KEY_LOCATION_IFX_SE) {
+            ifx_se_key_id_fih_t se_key = IFX_SE_KEY_ID_FIH_INIT;
+            ifx_se_key_attributes_t se_attributes;
+            (void) memcpy(&se_key, slot->key.data, sizeof(se_key));
+
+            status = ifx_se_get_psa_status(
+                        ifx_se_get_key_attributes(se_key,
+                                                  &se_attributes,
+                                                  IFX_SE_NULL_CTX));
+            if (status == PSA_SUCCESS) {
+                ifx_se_attributes_se_to_psa(&se_attributes, attributes);
+            }
+
+            if (status != PSA_SUCCESS) {
+                psa_reset_key_attributes(attributes);
+            }
+
+            psa_status_t unlock_status = psa_unregister_read_under_mutex(slot);
+            return (status == PSA_SUCCESS) ? unlock_status : status;
+        }
+    }
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
+
     return psa_unregister_read_under_mutex(slot);
 }
 
@@ -2354,35 +2399,49 @@ psa_status_t psa_hash_verify(psa_hash_operation_t *operation,
                              const uint8_t *hash_external,
                              size_t hash_length)
 {
-    uint8_t actual_hash[PSA_HASH_MAX_SIZE];
-    size_t actual_hash_length;
     psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
     LOCAL_INPUT_DECLARE(hash_external, hash);
+    LOCAL_INPUT_ALLOC(hash_external, hash_length, hash);
 
-    status = psa_hash_finish_internal(
-        operation,
-        actual_hash, sizeof(actual_hash),
-        &actual_hash_length);
+#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)
+#if defined(IFX_PSA_SE_DPA_PRESENT)
+    if (operation->id == IFX_SE_DPA_DRIVER_ID) {
+        status = ifx_se_get_psa_status(ifx_se_hash_verify(
+            &operation->ctx.ifx_se_dpa_ctx,
+            ifx_se_fih_ptr_encode(hash),
+            ifx_se_fih_uint_encode(hash_length),
+            IFX_SE_NULL_CTX
+        ));
+    }
+    else
+#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */
+#endif /* IFX_PSA_SE_DPA_PRESENT */
+    {
+        uint8_t actual_hash[PSA_HASH_MAX_SIZE];
+        size_t actual_hash_length;
+        status = psa_hash_finish_internal( operation,
+                                actual_hash, sizeof( actual_hash ),
+                                &actual_hash_length );
 
-    if (status != PSA_SUCCESS) {
-        goto exit;
-    }
+        if( status == PSA_SUCCESS )
+        {
+            status = PSA_ERROR_INVALID_SIGNATURE;
 
-    if (actual_hash_length != hash_length) {
-        status = PSA_ERROR_INVALID_SIGNATURE;
-        goto exit;
-    }
+            if( actual_hash_length == hash_length )
+            {
+                if( mbedtls_ct_memcmp( hash, actual_hash, actual_hash_length ) == 0 )
+                {
+                    status = PSA_SUCCESS;
+                }
+            }
+        }
 
-    LOCAL_INPUT_ALLOC(hash_external, hash_length, hash);
-    if (mbedtls_ct_memcmp(hash, actual_hash, actual_hash_length) != 0) {
-        status = PSA_ERROR_INVALID_SIGNATURE;
+        mbedtls_platform_zeroize( actual_hash, sizeof( actual_hash ) );
     }
-
+#if !defined(MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS)
 exit:
-    mbedtls_platform_zeroize(actual_hash, sizeof(actual_hash));
-    if (status != PSA_SUCCESS) {
-        psa_hash_abort(operation);
-    }
+#endif
+    psa_hash_abort(operation);
     LOCAL_INPUT_FREE(hash_external, hash);
     return status;
 }
@@ -2677,6 +2736,8 @@ psa_status_t psa_mac_abort(psa_mac_operation_t *operation)
     }
 
     psa_status_t status = psa_driver_wrapper_mac_abort(operation);
+
+    mbedtls_platform_zeroize(&operation->ctx, sizeof(operation->ctx));
     operation->mac_size = 0;
     operation->is_sign = 0;
     operation->id = 0;
@@ -3036,33 +3097,68 @@ psa_status_t psa_mac_verify(mbedtls_svc_key_id_t key,
                             size_t mac_length)
 {
     psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
-    uint8_t actual_mac[PSA_MAC_MAX_SIZE];
-    size_t actual_mac_length;
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+#endif
     LOCAL_INPUT_DECLARE(input_external, input);
     LOCAL_INPUT_DECLARE(mac_external, mac);
-
     LOCAL_INPUT_ALLOC(input_external, input_length, input);
-    status = psa_mac_compute_internal(key, alg,
-                                      input, input_length,
-                                      actual_mac, sizeof(actual_mac),
-                                      &actual_mac_length, 0);
-    if (status != PSA_SUCCESS) {
-        goto exit;
-    }
+    LOCAL_INPUT_ALLOC(mac_external, mac_length, mac);
 
-    if (mac_length != actual_mac_length) {
-        status = PSA_ERROR_INVALID_SIGNATURE;
-        goto exit;
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    status = psa_get_key_attributes(key, &attributes);
+
+    if ((status == PSA_SUCCESS) && (psa_key_lifetime_is_external(psa_get_key_lifetime(&attributes))))
+    {
+        psa_status_t unlock_status = PSA_ERROR_CORRUPTION_DETECTED;
+        ifx_se_key_id_fih_t se_key = IFX_SE_KEY_ID_FIH_INIT;
+        psa_key_slot_t *slot;
+
+        status = psa_get_and_lock_key_slot( key, &slot );
+        if (status == PSA_SUCCESS)
+        {
+            (void)memcpy(&se_key, slot->key.data, sizeof(se_key));
+
+            status = ifx_se_get_psa_status( ifx_se_mac_verify(
+                se_key,
+                ifx_se_fih_uint_encode(alg),
+                ifx_se_fih_ptr_encode(input), ifx_se_fih_uint_encode(input_length),
+                ifx_se_fih_ptr_encode(mac), ifx_se_fih_uint_encode(mac_length),
+                IFX_SE_NULL_CTX));
+        }
+
+        unlock_status = psa_unregister_read_under_mutex( slot );
+        if (status == PSA_SUCCESS)
+        {
+            status = unlock_status;
+        }
     }
+    else
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
+    {
+        uint8_t actual_mac[PSA_MAC_MAX_SIZE];
+        size_t actual_mac_length;
+        status = psa_mac_compute_internal(key, alg,
+                                          input, input_length,
+                                          actual_mac, sizeof(actual_mac),
+                                          &actual_mac_length, 0);
+        if (status == PSA_SUCCESS) {
+            if (mac_length == actual_mac_length) {
+                if (mbedtls_ct_memcmp(mac, actual_mac, actual_mac_length) != 0) {
+                    status = PSA_ERROR_INVALID_SIGNATURE;
+                }
+            }
+            else {
+                status = PSA_ERROR_INVALID_SIGNATURE;
+            }
+		}
 
-    LOCAL_INPUT_ALLOC(mac_external, mac_length, mac);
-    if (mbedtls_ct_memcmp(mac, actual_mac, actual_mac_length) != 0) {
-        status = PSA_ERROR_INVALID_SIGNATURE;
-        goto exit;
+        mbedtls_platform_zeroize(actual_mac, sizeof(actual_mac));
     }
 
+#if !defined(MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS)
 exit:
-    mbedtls_platform_zeroize(actual_mac, sizeof(actual_mac));
+#endif
     LOCAL_INPUT_FREE(input_external, input);
     LOCAL_INPUT_FREE(mac_external, mac);
 
@@ -4052,7 +4148,7 @@ psa_status_t mbedtls_psa_sign_hash_start(
     const uint8_t *hash, size_t hash_length)
 {
     psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
-    size_t required_hash_length;
+    size_t required_hash_length = 0;
 
     if (!PSA_KEY_TYPE_IS_ECC_KEY_PAIR(attributes->type)) {
         return PSA_ERROR_NOT_SUPPORTED;
@@ -4593,15 +4689,26 @@ psa_status_t psa_cipher_generate_iv(psa_cipher_operation_t *operation,
     }
 
     LOCAL_OUTPUT_ALLOC(iv_external, default_iv_length, iv);
+#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)
+#if defined(IFX_PSA_SE_DPA_PRESENT)
+    if (operation->id == IFX_SE_DPA_DRIVER_ID) {
+            status = ifx_se_get_psa_status( ifx_se_cipher_generate_iv(
+                        &operation->ctx.ifx_se_dpa_ctx,
+                        ifx_se_fih_ptr_encode(iv), ifx_se_fih_uint_encode(iv_size), ifx_se_fih_ptr_encode(iv_length),
+                        IFX_SE_NULL_CTX));
+    }
+    else
+#endif /* IFX_PSA_SE_DPA_PRESENT */
+#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */
+    {
+        status = psa_generate_random_internal(iv, default_iv_length);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
 
-    status = psa_generate_random_internal(iv, default_iv_length);
-    if (status != PSA_SUCCESS) {
-        goto exit;
+        status = psa_driver_wrapper_cipher_set_iv(operation,
+                                                iv, default_iv_length);
     }
-
-    status = psa_driver_wrapper_cipher_set_iv(operation,
-                                              iv, default_iv_length);
-
 exit:
     if (status == PSA_SUCCESS) {
         *iv_length = default_iv_length;
@@ -4962,7 +5069,9 @@ static psa_status_t psa_aead_check_nonce_length(psa_algorithm_t alg,
             return PSA_ERROR_NOT_SUPPORTED;
     }
 
+#if (defined(PSA_WANT_ALG_GCM) || defined(PSA_WANT_ALG_CCM) || defined(PSA_WANT_ALG_CHACHA20_POLY1305))
     return PSA_ERROR_INVALID_ARGUMENT;
+#endif
 }
 
 static psa_status_t psa_aead_check_algorithm(psa_algorithm_t alg)
@@ -5143,7 +5252,9 @@ static psa_status_t psa_validate_tag_length(psa_algorithm_t alg)
             (void) tag_len;
             return PSA_ERROR_NOT_SUPPORTED;
     }
+#if (defined(PSA_WANT_ALG_CCM) || defined(PSA_WANT_ALG_GCM) || defined(PSA_WANT_ALG_CHACHA20_POLY1305))
     return PSA_SUCCESS;
+#endif
 }
 
 /* Set the key for a multipart authenticated operation. */
@@ -5320,15 +5431,31 @@ psa_status_t psa_aead_generate_nonce(psa_aead_operation_t *operation,
         status = PSA_ERROR_BUFFER_TOO_SMALL;
         goto exit;
     }
-
-    status = psa_generate_random_internal(local_nonce, required_nonce_size);
-    if (status != PSA_SUCCESS) {
-        goto exit;
+#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)
+#if defined(IFX_PSA_SE_DPA_PRESENT)
+    if (operation->id == IFX_SE_DPA_DRIVER_ID) {
+        status = ifx_se_get_psa_status(ifx_se_aead_generate_nonce(
+            &operation->ctx.ifx_se_dpa_ctx,
+            ifx_se_fih_ptr_encode(nonce),
+            ifx_se_fih_uint_encode(nonce_size),
+            ifx_se_fih_ptr_encode(nonce_length),
+            IFX_SE_NULL_CTX));
+        if(status == PSA_SUCCESS) {
+            operation->nonce_set = 1;
+        }
     }
+    else
+#endif /* IFX_PSA_SE_DPA_PRESENT */
+#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */
+    {
+        status = psa_generate_random_internal(local_nonce, required_nonce_size);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
 
-    status = psa_aead_set_nonce_internal(operation, local_nonce,
-                                         required_nonce_size);
-
+        status = psa_aead_set_nonce_internal(operation, local_nonce,
+                                            required_nonce_size);
+    }
 exit:
     if (status == PSA_SUCCESS) {
         memcpy(nonce, local_nonce, required_nonce_size);
@@ -5834,6 +5961,14 @@ psa_status_t psa_key_derivation_abort(psa_key_derivation_operation_t *operation)
         status = PSA_SUCCESS;
     } else
 #endif /* MBEDTLS_PSA_BUILTIN_ALG_SP800_108_COUNTER_CMAC */
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    if ((kdf_alg == PSA_ALG_KDF_IFX_SE_AES_CMAC) &&
+        (operation->ctx.ifx_se_op.operation_handle != 0u)) {
+        status = ifx_se_get_psa_status(
+                    ifx_se_key_derivation_abort(&operation->ctx.ifx_se_op,
+                                                IFX_SE_NULL_CTX));
+    } else
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
     {
         status = PSA_ERROR_BAD_STATE;
     }
@@ -5849,6 +5984,19 @@ psa_status_t psa_key_derivation_get_capacity(const psa_key_derivation_operation_
         return PSA_ERROR_BAD_STATE;
     }
 
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    /* SE RT Services operation started with supported algorithm */
+    if ((operation->alg == PSA_ALG_KDF_IFX_SE_AES_CMAC) &&
+        (operation->ctx.ifx_se_op.operation_handle != 0u))
+    {
+        return (ifx_se_get_psa_status(
+                    ifx_se_key_derivation_get_capacity(
+                        &operation->ctx.ifx_se_op,
+                        ifx_se_fih_ptr_encode(capacity),
+                        IFX_SE_NULL_CTX)));
+    }
+    else
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
     *capacity = operation->capacity;
