     }
     if (status == PSA_SUCCESS) {
         status = psa_finish_key_creation(slot, key);
@@ -7133,9 +7329,30 @@ psa_status_t psa_key_derivation_setup(psa_key_derivation_operation_t *operation,
 #endif /* AT_LEAST_ONE_BUILTIN_KDF */
     } else if (PSA_ALG_IS_KEY_DERIVATION(alg)) {
 #if defined(AT_LEAST_ONE_BUILTIN_KDF)
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
