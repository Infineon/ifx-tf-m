@@ -6858,9 +7030,33 @@ psa_status_t psa_key_derivation_output_key_custom(
 
     status = psa_start_key_creation(attributes, &slot);
     if (status == PSA_SUCCESS) {
-        status = psa_generate_derived_key_internal(slot,
-                                                   attributes->bits,
