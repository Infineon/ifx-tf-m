 }
@@ -5863,6 +6011,17 @@ psa_status_t psa_key_derivation_set_capacity(psa_key_derivation_operation_t *ope
         return PSA_ERROR_INVALID_ARGUMENT;
     }
 
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
+    if ((operation->alg == PSA_ALG_KDF_IFX_SE_AES_CMAC) &&
+        (operation->ctx.ifx_se_op.operation_handle != 0u)) {
+        return ifx_se_get_psa_status(
+                    ifx_se_key_derivation_set_capacity(
+                        &operation->ctx.ifx_se_op,
+                        ifx_se_fih_uint_encode(capacity),
+                        IFX_SE_NULL_CTX));
+    } else
+#endif /* MBEDTLS_PSA_CRYPTO_DRIVERS && IFX_PSA_SE_DPA_PRESENT */
+
 #ifdef PSA_WANT_ALG_SP800_108_COUNTER_CMAC
     /* Capacity must be set only once */
     if (PSA_ALG_IS_SP800_108_COUNTER_CMAC(operation->alg) &&
@@ -6490,7 +6649,20 @@ psa_status_t psa_key_derivation_output_bytes(
                                                 output, output_length);
     } else
 #endif /* PSA_HAVE_SOFT_PBKDF2 */
-
+#if defined(MBEDTLS_PSA_CRYPTO_DRIVERS) && defined(IFX_PSA_SE_DPA_PRESENT)
