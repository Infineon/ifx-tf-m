From 5931ae6856265491a195b12cb78aa082e4570f2b Mon Sep 17 00:00:00 2001
From: "Kozemchuk Ivan (CSS ICW SW SCV BFS SFW / EE)"
 <Ivan.Kozemchuk-EE@infineon.com>
Date: Tue, 30 Jun 2026 17:16:51 +0300
Subject: [PATCH] fixes from Security Audit

---
 core/psa_crypto.c                 | 7 ++++---
 core/psa_crypto_driver_wrappers.h | 3 ++-
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/core/psa_crypto.c b/core/psa_crypto.c
index 3a0474163..23d118c2c 100644
--- a/core/psa_crypto.c
+++ b/core/psa_crypto.c
@@ -1234,7 +1234,7 @@ psa_status_t psa_destroy_key(mbedtls_svc_key_id_t key)
 {
     psa_key_slot_t *slot;
     psa_status_t status; /* status of the last operation */
-    psa_status_t overall_status = PSA_SUCCESS;
+    psa_status_t overall_status = PSA_ERROR_CORRUPTION_DETECTED;
 
     if (mbedtls_svc_key_id_is_null(key)) {
         return PSA_SUCCESS;
@@ -3117,6 +3117,7 @@ psa_status_t psa_mac_verify(mbedtls_svc_key_id_t key,
         status = psa_get_and_lock_key_slot( key, &slot );
         if (status == PSA_SUCCESS)
         {
+            status = PSA_ERROR_CORRUPTION_DETECTED;
             (void)memcpy(&se_key, slot->key.data, sizeof(se_key));
 
             status = ifx_se_get_psa_status( ifx_se_mac_verify(
@@ -4544,7 +4545,7 @@ static psa_status_t psa_generate_random_internal(uint8_t *output,
 
 #if defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)
 
-    psa_status_t status;
+    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
     size_t output_length = 0;
     status = mbedtls_psa_external_get_random(&global_data.rng,
                                              output, output_size,
@@ -8814,7 +8815,7 @@ psa_status_t psa_random_set_prediction_resistance(unsigned enabled)
 psa_status_t psa_generate_random(uint8_t *output_external,
                                  size_t output_size)
 {
-    psa_status_t status;
+    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
 
     LOCAL_OUTPUT_DECLARE(output_external, output);
     LOCAL_OUTPUT_ALLOC(output_external, output_size, output);
diff --git a/core/psa_crypto_driver_wrappers.h b/core/psa_crypto_driver_wrappers.h
index 6523df2de..5fc589d74 100644
--- a/core/psa_crypto_driver_wrappers.h
+++ b/core/psa_crypto_driver_wrappers.h
@@ -1229,8 +1229,9 @@ static inline psa_status_t psa_driver_wrapper_import_key(
                 ifx_se_key_attributes_t se_attributes;
 
                 ifx_se_attributes_psa_to_se(attributes, &se_attributes);
+
+                data_crc = IFX_CRC32_CALC(data, data_length);
                 memcpy(temp_data, data, data_length);
-                data_crc = IFX_CRC32_CALC(temp_data, data_length);
                 memcpy(temp_data + data_length, &data_crc, IFX_CRC32_CRC_SIZE);
                 data_length += IFX_CRC32_CRC_SIZE;
 
